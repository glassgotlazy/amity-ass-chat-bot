# Copy this file to ".env" (same folder) and put your real key in that copy.
# .env is git-ignored — never commit it, never paste a key into chat.
#
# The key is only ever read by server.js, on your machine. It is not sent to
# the browser, and index.html never sees it.
#
# Set ONE of the two keys below. Whichever is present decides the provider
# (OpenAI wins if both are set). Leave both empty and everything still works:
# the chatbot just runs as a pure offline knowledge base with the AI
# fallback switched off.

# --- OpenAI ---
OPENAI_API_KEY=
# Any chat model your account can use. List yours with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=gpt-4o-mini

# --- or Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- server ---
PORT=3000
